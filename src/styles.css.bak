:root{--bg:#faf8f4;--card:#fff;--ink:#1b1b1f;--mut:#6b6b73;--gold:#9a742a;--ongold:#fff;--goldbg:#f3ead6;--line:#e7e2d8;--bad:#b3261e;color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f0f12;--card:#18181d;--ink:#f1efe9;--mut:#9d9da6;--gold:#d4b26a;--ongold:#111;--goldbg:#2a2417;--line:#2a2a31;--bad:#ff8a80;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0f0f12;--card:#18181d;--ink:#f1efe9;--mut:#9d9da6;--gold:#d4b26a;--ongold:#111;--goldbg:#2a2417;--line:#2a2a31;--bad:#ff8a80;color-scheme:dark}
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.5}
h1,h2,h3,.brand{font-family:"Cormorant Garamond",Georgia,serif;margin:0}
button,input,select,textarea{font:inherit;color:inherit}
.wrap{max-width:1180px;margin:0 auto;padding:0 16px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:12px 0}
.brand{font-size:1.7rem;letter-spacing:.18em;color:var(--gold);font-weight:700;margin-right:auto}
nav{display:flex;gap:4px;flex-wrap:wrap}
.tab{background:none;border:0;padding:8px 12px;border-radius:999px;cursor:pointer;color:var(--mut);font-weight:500}
.tab.on{background:var(--goldbg);color:var(--gold)}
.ico{position:relative;background:none;border:1px solid var(--line);border-radius:999px;width:42px;height:42px;display:grid;place-items:center;cursor:pointer}
.ico.on{border-color:var(--gold);color:var(--gold);background:var(--goldbg)}
.bdg{position:absolute;top:-6px;right:-6px;background:var(--gold);color:var(--ongold);border-radius:99px;font-size:.72rem;font-weight:600;min-width:20px;height:20px;display:grid;place-items:center;padding:0 5px}
.btn{background:var(--gold);color:var(--ongold);border:0;border-radius:999px;padding:9px 18px;cursor:pointer;font-weight:600}
.btn:disabled{opacity:.4;cursor:not-allowed}
.btn.ghost{background:none;color:var(--ink);border:1px solid var(--line)}
.btn.bad{background:none;color:var(--bad);border:1px solid var(--bad)}
.btn.sm{padding:5px 12px;font-size:.85rem}
main{padding:24px 0 64px}
.hero{padding:32px 0 8px}.hero h1{font-size:clamp(2rem,6vw,3.4rem);line-height:1.1}.hero p{color:var(--mut);max-width:520px}
.tools{display:flex;gap:8px;flex-wrap:wrap;margin:20px 0}
.chip{border:1px solid var(--line);background:var(--card);padding:7px 14px;border-radius:999px;cursor:pointer}
.chip.on{border-color:var(--gold);color:var(--gold);background:var(--goldbg)}
input,select,textarea{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px;width:100%}
.tools input{max-width:260px;margin-left:auto}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden;display:flex;flex-direction:column}
.thumb{aspect-ratio:4/3;display:grid;place-items:center;font-size:4rem;position:relative}
.g0{background:linear-gradient(135deg,#c9a96a55,#8a6a2a22)}.g1{background:linear-gradient(135deg,#e8c9d055,#9a742a22)}.g2{background:linear-gradient(135deg,#b8c4d055,#6b6b7322)}
.tag{position:absolute;top:10px;left:10px;font-size:.72rem;font-style:normal;background:var(--goldbg);color:var(--gold);padding:2px 10px;border-radius:99px}
.tag.out{background:var(--bad);color:#fff}
.cb{padding:14px;display:flex;flex-direction:column;gap:4px;flex:1}.cb small{color:var(--gold);text-transform:uppercase;letter-spacing:.1em;font-size:.7rem}
.cb h3{font-size:1.3rem}.cb p{margin:0;color:var(--mut);font-size:.88rem;flex:1}
.row{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:10px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;margin-bottom:14px}
.empty{text-align:center;padding:40px 16px;display:grid;gap:10px;justify-items:center}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:4px}
.kpi b{display:block;font-size:1.6rem;font-family:"Cormorant Garamond",Georgia,serif;color:var(--gold)}
.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}
.scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:560px}
th,td{text-align:left;padding:10px 8px;border-bottom:1px solid var(--line);font-size:.9rem}th{color:var(--mut);font-weight:500}
.badge{padding:2px 10px;border-radius:99px;background:var(--goldbg);color:var(--gold);font-size:.78rem}
.ci{display:flex;justify-content:space-between;gap:10px;align-items:center;border-bottom:1px solid var(--line);padding:10px 0}
.cinfo{display:flex;align-items:center;gap:12px;flex:1}.mini{width:48px;height:48px;border-radius:12px;display:grid;place-items:center;font-size:1.6rem}
.qty{display:flex;align-items:center;gap:8px}
.ov{position:fixed;inset:0;background:#0008;z-index:40;display:flex;justify-content:center;align-items:center;padding:16px}
.modal{background:var(--bg);width:min(480px,100%);max-height:100%;overflow:auto;border-radius:16px;padding:20px;display:grid;gap:10px}
label{display:grid;gap:4px;font-size:.85rem;color:var(--mut)}
.auth{max-width:400px;margin:8vh auto;padding:0 16px;display:grid;gap:12px}.auth h1{font-size:2.4rem;color:var(--gold);letter-spacing:.15em;text-align:center}
.err{color:var(--bad);font-size:.88rem}.mut{color:var(--mut);font-size:.85rem}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 20px;border-radius:99px;z-index:60;max-width:92vw;text-align:center}
@media (max-width:600px){.tools input{max-width:none;margin:0}.brand{font-size:1.4rem}.user{display:none}.ci{flex-wrap:wrap}}
a{color:inherit;text-decoration:none}
.ico{text-decoration:none;color:var(--ink)}
.card{position:relative}
.thumb{overflow:hidden}.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.thumb.mini{width:48px;height:48px;aspect-ratio:auto;font-size:1.6rem;border-radius:12px;flex:none}
.cb p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.heart{position:absolute;top:10px;right:10px;width:36px;height:36px;border-radius:99px;border:0;background:var(--card);color:var(--gold);font-size:1.2rem;cursor:pointer;box-shadow:0 1px 6px #0003}
.detail{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:28px;margin:16px 0 36px}
.thumb.big{aspect-ratio:1/1;font-size:8rem;border-radius:18px}
.dinfo{display:flex;flex-direction:column;gap:10px}.dinfo h1{font-size:clamp(2rem,5vw,3rem)}
.gold{color:var(--gold);text-transform:uppercase;letter-spacing:.1em}.price{font-size:1.8rem;color:var(--gold)}.full{white-space:pre-line;margin:0}
.sum{display:grid;grid-template-columns:1fr auto;gap:4px 12px;margin-top:10px}
.sum span:nth-child(even){text-align:right}.sum b:last-child{text-align:right}
.addr{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}.addr>b,.addr .full{grid-column:1/-1}
.sort{max-width:180px;width:auto}
.chart{width:100%;max-width:560px;display:block;margin:8px auto 0}
.pv{width:100%;max-height:200px;object-fit:cover;border-radius:12px}
.tn{width:44px;height:44px;object-fit:cover;border-radius:8px;display:block}
details.panel summary{cursor:pointer}
